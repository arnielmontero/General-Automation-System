# Copy to .env and fill in.

# --- Odoo ---
ODOO_URL=https://erp.sawo.com
ODOO_DB=sawo
# Odoo login(s) that are always Admin in this system (comma-separated). Other users start as "User".
ADMIN_ODOO_LOGIN=arniel.montero@sawo.com

# --- Web app ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Host names / IPs people use to open the app, comma-separated (* = any).
ALLOWED_HOSTS=*
# Full origins when opened by IP or name, e.g. http://192.168.1.20:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8085
TIME_ZONE=Asia/Manila
WEB_PORT=8085
# Hours a login stays valid.
SESSION_HOURS=12

# --- Database ---
POSTGRES_DB=gas
POSTGRES_USER=gas
POSTGRES_PASSWORD=change-me
